# Database URL:
# - Leave default SQLite for zero-setup quick local start
# - Use Docker Compose Postgres inside containers
# - Or paste your Neon Cloud Free PostgreSQL connection string:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./data/predictions.db

# Model artifact configuration
MODEL_PATH=artifacts/model_int8.onnx
TOKENIZER_PATH=artifacts/tokenizer.json
BASELINE_STATS_PATH=artifacts/baseline_stats.json
MODEL_VERSION=transformer-onnx-int8-v1

# Drift window and alert threshold (Population Stability Index)
DRIFT_WINDOW_SIZE=100
DRIFT_PSI_THRESHOLD=0.25
PORT=8000
